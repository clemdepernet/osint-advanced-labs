# Dockerfile.osint - minimal, disposable OSINT investigation container.
#
# Why this exists: Exegol Community only ships the 42 GB "free" image (the
# dedicated "osint" image is Pro/Enterprise). This ~2 GB image gives the same
# OPSEC properties for the lab: disposable, UTC, neutral hostname, Tor SOCKS
# proxy, username/email pivot tools, metadata tools.
#
# Build:   docker build -t osint-lab:latest -f Dockerfile.osint .
# Run:     see osint_case.sh (or the manual docker run command in the lab sheet)
#
# NOTE: the image itself is a fingerprint too. Do not add your name, real
# git identity or personal dotfiles in here.

FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=UTC \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PIPX_HOME=/opt/pipx \
    PIPX_BIN_DIR=/usr/local/bin

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl wget git jq nano less procps dnsutils iproute2 \
        python3 python3-pip python3-venv pipx \
        tor torsocks proxychains4 \
        libimage-exiftool-perl mat2 ffmpeg mediainfo \
        whois nmap \
        zsh tzdata \
    && ln -sf /usr/share/zoneinfo/UTC /etc/localtime && echo "UTC" > /etc/timezone \
    && rm -rf /var/lib/apt/lists/*

# OSINT pivot tools, isolated in their own venvs (pipx)
RUN pipx install sherlock-project \
    && pipx install holehe \
    && pipx install maigret \
    && pipx install waybackpy \
    && pipx install yt-dlp

# Lab Python deps (persona generator, footprint audit)
RUN python3 -m venv /opt/labvenv && /opt/labvenv/bin/pip install --no-cache-dir faker requests

# Tor: local SOCKS proxy on 9050 for curl/sherlock/torsocks. Started by the entrypoint.
RUN printf 'SocksPort 127.0.0.1:9050\nLog notice stdout\nDataDirectory /var/lib/tor\n' > /etc/tor/torrc

# proxychains -> Tor by default (so `proxychains4 sherlock <handle>` is torified)
RUN sed -i 's/^socks4.*/socks5 127.0.0.1 9050/' /etc/proxychains4.conf \
    && sed -i 's/^#proxy_dns/proxy_dns/' /etc/proxychains4.conf

# Non-root, neutral user. No history persisted across sessions.
RUN useradd -m -s /bin/zsh -u 1000 analyst \
    && mkdir -p /workspace && chown analyst:analyst /workspace \
    && echo 'export HISTFILE=/dev/null' >> /home/analyst/.zshrc \
    && echo 'export PATH=/opt/labvenv/bin:$PATH' >> /home/analyst/.zshrc \
    && echo 'alias tcurl="curl --socks5-hostname 127.0.0.1:9050"' >> /home/analyst/.zshrc \
    && echo 'PROMPT="%F{cyan}[osint-lab]%f %~ %# "' >> /home/analyst/.zshrc

COPY --chmod=755 entrypoint.sh /usr/local/bin/entrypoint.sh

WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["zsh"]
